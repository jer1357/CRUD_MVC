@{
    ViewData["Title"] = "永慶房屋面試題目";
}

<div class="bg-light p-5 rounded text-center">
    <h1 class="display-4">🏡 永慶房屋面試專題</h1>
    <p class="lead">這是一個 ASP.NET Core MVC 的測試專案，包含 CRUD 功能，使用 SQL Server 進行資料庫管理。</p>
    <p>
        <a href="https://learn.microsoft.com/aspnet/core" class="btn btn-primary btn-lg">
            了解 ASP.NET Core &raquo;
        </a>
    </p>
</div>

