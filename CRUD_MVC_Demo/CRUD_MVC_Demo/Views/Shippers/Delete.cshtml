@model CRUD_MVC_Demo.Models.Shipper

@{
    ViewData["Title"] = "⚠️ 刪除貨運公司";
}

<h2 class="text-danger">⚠️ 確定要刪除嗎？</h2>

<div class="alert alert-danger">
    <p>您確定要刪除 <strong>@Model.CompanyName</strong> 這間貨運公司嗎？此操作無法復原！</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="ShipperId" />
    <button type="submit" class="btn btn-danger">🗑️ 確定刪除</button>
    <a asp-action="Index" class="btn btn-secondary">🔙 取消</a>
</form>


