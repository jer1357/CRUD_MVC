@model CRUD_MVC_Demo.Models.Shipper

@{
    ViewData["Title"] = "🔍 貨運公司詳細資訊";
}

<h2 class="text-primary">🔍 貨運公司詳細資訊</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.CompanyName</h4>
        <p class="card-text"><strong>📞 聯絡電話：</strong> @Model.Phone</p>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.ShipperId" class="btn btn-warning">✏️ 編輯</a>
<a asp-action="Index" class="btn btn-secondary">🔙 返回列表</a>

