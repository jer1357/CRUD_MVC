@model CRUD_MVC_Demo.Models.Shipper

@{
    ViewData["Title"] = "✏️ 編輯貨運公司";
}

<h2 class="text-primary">✏️ 編輯貨運公司</h2>

<form asp-action="Edit" class="mt-3">
    <input type="hidden" asp-for="ShipperId" />
    <div class="mb-3">
        <label class="form-label">📦 公司名稱：</label>
        <input asp-for="CompanyName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">📞 聯絡電話：</label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">💾 保存變更</button>
    <a asp-action="Index" class="btn btn-secondary">🔙 返回列表</a>
</form>

