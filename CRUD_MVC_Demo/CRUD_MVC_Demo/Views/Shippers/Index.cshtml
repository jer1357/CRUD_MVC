@model IEnumerable<CRUD_MVC_Demo.Models.Shipper>

@{
    ViewData["Title"] = "貨運公司列表";
    <!-- 中文化標題 -->
}

<h2 class="text-primary">🚚 貨運公司列表</h2>

<a asp-action="Create" class="btn btn-success mb-3">➕ 新增貨運公司</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>📦 公司名稱</th>
            <th>📞 聯絡電話</th>
            <th>⚙️ 操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CompanyName</td>
                <td>@item.Phone</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ShipperId" class="btn btn-warning btn-sm">✏️ 編輯</a>
                    <a asp-action="Details" asp-route-id="@item.ShipperId" class="btn btn-info btn-sm">🔍 詳細</a>
                    <a asp-action="Delete" asp-route-id="@item.ShipperId" class="btn btn-danger btn-sm">🗑️ 刪除</a>
                </td>
            </tr>
        }
    </tbody>
</table>

